worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$host" $upstream_cache_status';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 0;

{% if dns_server_ip is defined and (dns_server_ip | string | length) > 0 %}
    resolver {{ dns_server_ip }} ipv4=on ipv6=off valid=300s;
{% else %}
    resolver 1.1.1.1 8.8.8.8 ipv4=on ipv6=off valid=300s;
{% endif %}
    resolver_timeout 5s;

    # APT Release/InRelease must not be served from a stale proxy_cache entry.
    map $uri $pkg_repo_skip_metadata_cache {
        default 0;
        ~^/dists/.+/(InRelease|Release|Release\.gpg)$ 1;
    }

    proxy_cache_path /var/cache/nginx/pkg-repo/metadata levels=1:2 keys_zone=pkg_repo_metadata_cache:50m max_size={{ pkg_repo_nginx_cache_metadata_max_size }} inactive=1d use_temp_path=off;
    proxy_cache_path /var/cache/nginx/pkg-repo/blobs levels=1:2 keys_zone=pkg_repo_blob_cache:200m max_size={{ pkg_repo_nginx_cache_blobs_max_size }} inactive=30d use_temp_path=off;

    include /etc/nginx/conf.d/pkg-repo-vhosts/pkg-repo-vhosts.conf;
}
