#!/bin/sh
set -eu

CERT="{{ custom_nginx_tls_dir }}/{{ custom_nginx_tls_cert_filename }}"
RENEW_BEFORE="{{ custom_nginx_tls_renew_before_seconds | int }}"
ISSUE_SCRIPT="{{ custom_nginx_compose_project_dir }}/issue-custom-nginx-tls-cert.sh"
CUSTOM_NGINX_UNIT="{{ compose_systemd_custom_nginx_unit_name }}.service"
REGISTRY_NGINX_UNIT="{{ compose_systemd_registry_nginx_unit_name }}.service"

need_renew=0

if [ ! -f "$CERT" ]; then
  need_renew=1
elif ! openssl x509 -checkend "$RENEW_BEFORE" -noout -in "$CERT" 2>/dev/null; then
  need_renew=1
fi

if [ "$need_renew" -eq 0 ]; then
  exit 0
fi

"$ISSUE_SCRIPT"
{% if custom_nginx_shared_with_registry | default(true) | bool and setup_registry_nginx | default(false) | bool %}
systemctl restart "$REGISTRY_NGINX_UNIT"
{% else %}
systemctl restart "$CUSTOM_NGINX_UNIT"
{% endif %}
