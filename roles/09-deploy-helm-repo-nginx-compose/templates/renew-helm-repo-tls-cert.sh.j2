#!/bin/sh
set -eu

CERT="{{ helm_repo_tls_dir }}/{{ helm_repo_tls_cert_filename }}"
RENEW_BEFORE="{{ helm_repo_tls_renew_before_seconds | int }}"
ISSUE_SCRIPT="{{ helm_repo_nginx_compose_project_dir }}/issue-helm-repo-tls-cert.sh"
HELM_COMPOSE_DIR="{{ helm_repo_nginx_compose_project_dir }}"
REGISTRY_COMPOSE_DIR="{{ registry_nginx_compose_project_dir }}"

need_renew=0

if [ ! -f "$CERT" ]; then
  need_renew=1
elif ! openssl x509 -checkend "$RENEW_BEFORE" -noout -in "$CERT" 2>/dev/null; then
  need_renew=1
fi

if [ "$need_renew" -eq 0 ]; then
  exit 0
fi

"$ISSUE_SCRIPT"
{% if helm_repo_nginx_shared_with_registry | default(true) | bool and setup_registry_nginx | default(false) | bool %}
docker compose -f "$REGISTRY_COMPOSE_DIR/docker-compose.yml" up -d --remove-orphans --force-recreate
{% else %}
docker compose -f "$HELM_COMPOSE_DIR/docker-compose.yml" up -d --remove-orphans --force-recreate
{% endif %}
