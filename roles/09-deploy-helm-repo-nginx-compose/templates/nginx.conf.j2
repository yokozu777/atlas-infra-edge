worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    server_names_hash_bucket_size 128;
    server_names_hash_max_size 2048;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$host" $upstream_cache_status';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 0;

    proxy_cache_path /var/cache/nginx/helm-repo levels=1:2 keys_zone=helm_repo_cache:100m max_size={{ helm_repo_nginx_cache_max_size }} inactive=7d use_temp_path=off;

    include /etc/nginx/conf.d/helm-repo-vhosts/helm-repo-vhosts.conf;
}
