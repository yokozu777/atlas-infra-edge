<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Infra stats — {{ dns_domain_suffix | default('lab') }}</title>
  <style>
    :root {
      --bg: #000;
      --panel: #111;
      --text: #e7ecf3;
      --muted: #9aa8bc;
      --accent: #5b9fd4;
      --link: #c9e4ff;
      --line: #2a2a2a;
      --ok: #3d9a6a;
      --off: #8a6a3d;
      --tab: #0a0a0a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      background: #000;
      color: var(--text);
      line-height: 1.45;
    }
    a {
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    a:hover { color: #fff; }
    header {
      padding: 1.5rem 1.25rem 0.75rem;
      border-bottom: 1px solid var(--line);
      text-align: center;
    }
    header h1 {
      margin: 0 0 0.35rem;
      font-size: 1.45rem;
      font-weight: 650;
      letter-spacing: 0.01em;
    }
    header p { margin: 0; color: var(--muted); font-size: 0.95rem; }
    header a { color: var(--link); }
    .action-row {
      display: grid;
      grid-template-columns: minmax(12rem, 15rem) 1fr;
      gap: 0.65rem 1rem;
      align-items: center;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--line);
    }
    .action-row:last-child { border-bottom: 0; }
    .action-row .desc { margin: 0; color: var(--muted); font-size: 0.9rem; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-width: 12rem;
      padding: 0.45rem 0.75rem;
      border-radius: 6px;
      background: #1a1a1a;
      color: #f4f9ff;
      text-decoration: none;
      border: 1px solid #8ec0ee;
      font-weight: 650;
      font-size: 0.86rem;
    }
    .btn:hover { background: #262626; color: #fff; }
    .icon {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .tabs {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      padding: 0.65rem 1.25rem;
      background: #000;
      border-bottom: 1px solid var(--line);
      max-width: 1100px;
      margin: 0 auto;
    }
    .tabs.sub {
      position: static;
      padding: 0.5rem 0 0.25rem;
      border-bottom: 0;
      max-width: none;
    }
    .tabs button {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border: 1px solid var(--line);
      background: var(--tab);
      color: var(--text);
      border-radius: 999px;
      padding: 0.35rem 0.7rem;
      cursor: pointer;
      font: inherit;
      font-size: 0.84rem;
      font-weight: 600;
    }
    .tabs button[aria-selected="true"] {
      background: #2c4c6c;
      border-color: #8ec0ee;
      color: #fff;
    }
    .tabs button:hover { border-color: #8ec0ee; }
    main {
      padding: 1rem 1.25rem 2.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    [data-panel] { display: none; }
    [data-panel].is-on { display: block; }
    [data-subpanel] { display: none; }
    [data-subpanel].is-on { display: block; }
    section {
      margin-top: 1.25rem;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.9rem 1rem 1rem;
    }
    section h2 {
      margin: 0 0 0.65rem;
      font-size: 1.05rem;
      font-weight: 600;
    }
    .note { color: var(--muted); font-size: 0.85rem; margin: 0 0 0.75rem; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    th, td {
      text-align: left;
      vertical-align: top;
      padding: 0.4rem 0.45rem;
      border-bottom: 1px solid var(--line);
    }
    th { color: var(--muted); font-weight: 550; }
    code, .mono {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.84em;
    }
    .break { word-break: break-all; }
    .badge {
      display: inline-block;
      padding: 0.1rem 0.45rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .on { background: color-mix(in srgb, var(--ok) 35%, transparent); color: #b8f0d0; }
    .off { background: color-mix(in srgb, var(--off) 35%, transparent); color: #f0d9b0; }
    ul.compact, ul.tight { margin: 0.2rem 0; padding-left: 1.1rem; }
    ul.compact li, ul.tight li { margin: 0.15rem 0; }
    .host { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 0.84em; }
    @media (max-width: 640px) {
      .action-row { grid-template-columns: 1fr; }
      .btn { width: 100%; min-width: 0; }
    }
  </style>
</head>
<body>
{% set ca = infra_stats_ca | default({}) %}
{% set hub = infra_stats_docker_hub | default({}) %}
{% macro ico(name) -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{ name }}"></use></svg>
{%- endmacro %}
{% macro host_link(name) -%}
{%- if name.startswith('*.') -%}
<span class="mono">{{ name }}</span>
{%- else -%}
<a class="host" href="https://{{ name }}">{{ name }}</a>
{%- endif -%}
{%- endmacro %}
{% macro cache_label(tid) -%}
{%- if tid == 'pkg-metadata' -%}APT / YUM metadata
{%- elif tid == 'pkg-blobs' -%}APT / YUM blobs
{%- elif tid == 'helm-repo' -%}Helm repos
{%- elif tid == 'helm-releases' -%}Helm releases
{%- elif tid == 'registry' -%}Docker / registry
{%- elif tid == 'custom-www' -%}Custom www
{%- else -%}{{ tid }}
{%- endif -%}
{%- endmacro %}
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
    <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"/><path d="M12 12h9M17 12v3M20 12v2"/></symbol>
    <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></symbol>
    <symbol id="i-box" viewBox="0 0 24 24"><path d="M4 8h16v11H4zM4 8l8-4 8 4M12 4v15"/></symbol>
    <symbol id="i-disk" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 4v6h8V4M8 20v-4h5"/></symbol>
    <symbol id="i-dns" viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h14"/><circle cx="8" cy="7" r="1.2" fill="currentColor" stroke="none"/><circle cx="16" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="10" cy="17" r="1.2" fill="currentColor" stroke="none"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M7 4h7l5 5v11H7zM14 4v5h5"/></symbol>
    <symbol id="i-script" viewBox="0 0 24 24"><path d="M8 6h11M8 12h11M8 18h7"/><path d="M5 6h.01M5 12h.01M5 18h.01"/></symbol>
    <symbol id="i-json" viewBox="0 0 24 24"><path d="M8 5c-2 0-3 2-3 7s1 7 3 7M16 5c2 0 3 2 3 7s-1 7-3 7"/></symbol>
  </svg>
  <header>
    <h1>Infra stats · {{ dns_domain_suffix | default('lab') }}</h1>
    <p>
      Generated by <span class="mono">{{ generated_by }}</span>
      · <a href="{{ infra_stats_path }}.json">{{ infra_stats_path }}.json</a>
      · host <span class="mono">{{ infra_stats_hostname }}</span>
    </p>
  </header>
  <nav class="tabs" role="tablist" data-tabs="main" aria-label="Infra stats">
    <button type="button" role="tab" data-tab="trust" aria-selected="true">{{ ico('key') }} Trust{% if not (ca.pem_ok | default(false)) %} <span class="badge off">pem missing</span>{% endif %}</button>
    <button type="button" role="tab" data-tab="endpoints" aria-selected="false">{{ ico('globe') }} Endpoints</button>
    <button type="button" role="tab" data-tab="mirrors" aria-selected="false">{{ ico('box') }} Mirrors{% if hub.stale | default(false) %} <span class="badge off">stale</span>{% elif hub.error | default('') %} <span class="badge off">failed</span>{% endif %}</button>
    <button type="button" role="tab" data-tab="cache" aria-selected="false">{{ ico('disk') }} Cache{% if not (infra_stats_cache_scrape_ok | default(true) | bool) %} <span class="badge off">{% if infra_stats_cache_scrape_stale | default(false) | bool %}stale{% else %}failed{% endif %}</span>{% endif %}</button>
    <button type="button" role="tab" data-tab="dns" aria-selected="false">{{ ico('dns') }} DNS{% if not (infra_stats_bind_scrape_ok | default(true) | bool) %} <span class="badge off">{% if infra_stats_bind_scrape_stale | default(false) | bool %}stale{% else %}failed{% endif %}</span>{% endif %}</button>
    <button type="button" role="tab" data-tab="time" aria-selected="false">{{ ico('clock') }} Time{% if (setup_ntp | default(false) | bool) and not (infra_stats_ntp_scrape_ok | default(true) | bool) %} <span class="badge off">{% if infra_stats_ntp_scrape_stale | default(false) | bool %}stale{% else %}failed{% endif %}</span>{% endif %}</button>
    <button type="button" role="tab" data-tab="tls" aria-selected="false">{{ ico('lock') }} TLS{% if not (infra_stats_known_scrape_ok | default(true) | bool) or not (infra_stats_issued_scrape_ok | default(true) | bool) %} <span class="badge off">{% if (infra_stats_known_scrape_stale | default(false) | bool) or (infra_stats_issued_scrape_stale | default(false) | bool) %}stale{% else %}failed{% endif %}</span>{% endif %}</button>
  </nav>
  <main>

    <div data-panel="trust" class="is-on">
    <section>
      <h2>Trust / CA</h2>
      <p class="note">
        First fetch uses <span class="mono">curl -k</span> (stats TLS is signed by this CA).
        Debian/Ubuntu: <span class="mono">update-ca-certificates</span>.
        RHEL/OL: <span class="mono">update-ca-trust extract</span>.
      </p>
      <div class="action-list">
      <div class="action-row">
        <a class="btn" href="{{ ca.pem_path | default('/ca/roots.pem') }}">{{ ico('key') }} Root CA PEM</a>
        <p class="desc">Lab step-ca root (<span class="mono">{{ ca.pem_path | default('/ca/roots.pem') }}</span>). Trust this before other lab HTTPS.{% if not (ca.pem_ok | default(false)) %} <span class="badge off">pem missing</span>{% endif %}</p>
      </div>
      <div class="action-row">
        <a class="btn" href="{{ ca.debian_sh | default('/ca/install-root-ca-debian.sh') }}">{{ ico('script') }} Debian/Ubuntu</a>
        <p class="desc">Install script for Debian/Ubuntu: curl the PEM with <span class="mono">-k</span>, then <span class="mono">update-ca-certificates</span>. Path <span class="mono">{{ ca.debian_sh | default('/ca/install-root-ca-debian.sh') }}</span>.</p>
      </div>
      <div class="action-row">
        <a class="btn" href="{{ ca.rhel_sh | default('/ca/install-root-ca-rhel.sh') }}">{{ ico('script') }} RHEL/OL</a>
        <p class="desc">Install script for RHEL/Oracle Linux: same PEM, then <span class="mono">update-ca-trust extract</span>. Path <span class="mono">{{ ca.rhel_sh | default('/ca/install-root-ca-rhel.sh') }}</span>.</p>
      </div>
      <div class="action-row">
        <a class="btn" href="{{ infra_stats_path }}.json">{{ ico('json') }} JSON</a>
        <p class="desc">Machine-readable snapshot of this page (<span class="mono">{{ infra_stats_path }}.json</span>) for scripts and scrape diffs.</p>
      </div>
      </div>
{% if ca.step_url | default('') %}
      <p class="note">step-ca: <a href="{{ ca.step_url }}" class="mono">{{ ca.step_url }}</a></p>
{% endif %}
{% for u in ca.upstream_urls | default([]) %}
{% if u and u != (ca.step_url | default('')) %}
      <p class="note">also: <a href="{{ u }}" class="mono">{{ u }}</a></p>
{% endif %}
{% endfor %}
    </section>
    </div>

    <div data-panel="endpoints">
    <section>
      <h2>Nginx locations</h2>
      <p class="note">Known stacks from inventory / templates (not a live <span class="mono">nginx -T</span> dump).</p>
      <table>
        <thead>
          <tr><th>Stack</th><th>State</th><th>Server names</th><th>Locations</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_nginx_locations | default([]) %}
          <tr>
            <td class="mono">{{ row.stack }}</td>
            <td>
{% if row.enabled | default(false) | bool %}
              <span class="badge on">enabled</span>
{% else %}
              <span class="badge off">disabled</span>
{% endif %}
            </td>
            <td>
              <ul class="compact">
{% for name in row.server_names | default([]) %}
{% if name %}
                <li>{{ host_link(name) }}</li>
{% endif %}
{% endfor %}
              </ul>
            </td>
            <td>
              <ul class="compact">
{% for loc in row.locations | default([]) %}
                <li><span class="mono">{{ loc.pattern }}</span> — {{ loc.note }}</li>
{% endfor %}
              </ul>
            </td>
          </tr>
{% else %}
          <tr><td colspan="4">No nginx summary available.</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>
    </div>

    <div data-panel="mirrors">
    <nav class="tabs sub" role="tablist" data-subtabs="mirrors" aria-label="Mirrors">
      <button type="button" role="tab" data-subtab="apt" aria-selected="true">APT / YUM</button>
      <button type="button" role="tab" data-subtab="helm" aria-selected="false">Helm repos</button>
      <button type="button" role="tab" data-subtab="docker" aria-selected="false">Docker / registry</button>
    </nav>
    <div data-subpanel="apt" class="is-on">
    <section>
      <h2>APT / YUM repos</h2>
      <p class="note">From <span class="mono">pkg_repo_upstreams</span> + <span class="mono">enable_repo_*</span>.</p>
{% if infra_stats_pkg_repos | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>Warm</th><th>Slug</th><th>Proxy host</th><th>Upstream</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_pkg_repos %}
          <tr>
            <td>
{% if row.enabled | default(false) | bool %}
              <span class="badge on">on</span>
{% else %}
              <span class="badge off">off</span>
{% endif %}
            </td>
            <td class="mono">{{ row.slug }}</td>
            <td>{% if row.proxy_hostname %}{{ host_link(row.proxy_hostname) }}{% endif %}</td>
            <td class="mono">{{ row.upstream_url }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">Pkg-repo mirror disabled or no upstreams.</p>
{% endif %}
    </section>
    </div>

    <div data-subpanel="helm">
    <section>
      <h2>Helm repos</h2>
      <p class="note">From <span class="mono">helm_repo_upstreams</span> → <span class="mono">*.helm.{{ dns_domain_suffix | default('') }}</span>.</p>
{% if infra_stats_helm_repos | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>Name</th><th>Proxy host</th><th>Upstream</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_helm_repos %}
          <tr>
            <td class="mono">{{ row.name }}</td>
            <td>{% if row.proxy_hostname %}{{ host_link(row.proxy_hostname) }}{% endif %}</td>
            <td class="mono">{{ row.upstream_url }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">Helm-repo mirror disabled or no upstreams.</p>
{% endif %}
    </section>
    </div>

    <div data-subpanel="docker">
    <section>
      <h2>Docker / registry mirrors</h2>
      <p class="note">From <span class="mono">containerd_registry_mirrors</span> / registry nginx server names.</p>
{% if hub.remaining is number %}
      <p>
{% if hub.ok | default(false) %}
        <span class="badge on">ok</span>
{% elif hub.stale | default(false) %}
        <span class="badge off">stale</span>
{% else %}
        <span class="badge off">scrape failed</span>
{% endif %}
        Hub pulls left: <span class="mono">{{ hub.remaining }} / {{ hub.limit | default('?') }}</span>
{% if hub.window_sec | default(0) %}
        (window {{ (hub.window_sec / 3600) | round(0, 'floor') | int }}h{% if hub.reset | default('') %}, reset {{ hub.reset }}{% endif %})
{% elif hub.reset | default('') %}
        (reset {{ hub.reset }})
{% endif %}
        · source <span class="mono">{{ hub.source | default('anonymous') }}</span>
        — anonymous Hub quota for this host WAN IP (pull-through shares it).
      </p>
{% elif hub.error | default('') %}
      <p class="note"><span class="badge off">scrape failed</span> Docker Hub quota: {{ hub.error | e }}</p>
{% else %}
      <p class="note">Docker Hub quota not scraped yet.</p>
{% endif %}
{% if infra_stats_docker_repos | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>dir_name</th><th>Proxy host</th><th>Upstream</th><th>Mode</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_docker_repos %}
          <tr>
            <td class="mono">{{ row.dir_name }}</td>
            <td>{% if row.proxy_hostname %}{{ host_link(row.proxy_hostname) }}{% endif %}</td>
            <td class="mono">{{ row.server }}</td>
            <td>{% if row.direct | default(false) | bool %}direct{% else %}proxy{% endif %}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">Registry nginx disabled or no mirrors.</p>
{% endif %}
    </section>
    </div>
    </div>

    <div data-panel="cache">
    <nav class="tabs sub" role="tablist" data-subtabs="cache" aria-label="Cache">
      <button type="button" role="tab" data-subtab="overview" aria-selected="true">Overview</button>
{% for tree in infra_stats_cache | default([]) %}
      <button type="button" role="tab" data-subtab="{{ tree.id | e }}" aria-selected="false">{{ cache_label(tree.id) }}</button>
{% endfor %}
    </nav>
    <div data-subpanel="overview" class="is-on">
    <section>
      <h2>Infra cache</h2>
{% if not (infra_stats_cache_scrape_ok | default(true) | bool) %}
{% if infra_stats_cache_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> Cache scrape soft-failed; previous snapshot kept.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> Cache scrape soft-failed; empty result.</p>
{% endif %}
{% else %}
      <p class="note">On-disk trees. Nginx pkg/helm rows are <span class="mono">KEY:</span> URIs (not an apt/helm catalog). Newest first; HTML shows up to <span class="mono">{{ infra_stats_cache_html_limit | default(200) }}</span> objects per tree — full list in <span class="mono">{{ infra_stats_path }}.json</span>.</p>
{% endif %}
{% if infra_stats_cache | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>Tree</th><th>Path</th><th>Size</th><th>Files</th><th>Newest</th><th>State</th></tr>
        </thead>
        <tbody>
{% for tree in infra_stats_cache %}
          <tr>
            <td class="mono">{{ tree.id | e }}</td>
            <td class="mono break">{{ tree.path | e }}</td>
            <td class="mono">{{ tree.size_human | default('0 B') | e }}</td>
            <td class="mono">{{ tree.files | default(0) }}</td>
            <td class="mono">{{ tree.newest | default('') | e }}</td>
            <td>
{% if tree.present | default(false) | bool %}
{% if (tree.files | default(0)) | int > 0 %}
              <span class="badge on">present</span>
{% else %}
              <span class="badge off">empty</span>
{% endif %}
{% else %}
              <span class="badge off">missing</span>
{% endif %}
            </td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">No cache trees enabled (pkg/helm/registry/custom-www gates off).</p>
{% endif %}
    </section>
    </div>
{% for tree in infra_stats_cache | default([]) %}
    <div data-subpanel="{{ tree.id | e }}">
    <section>
      <h2>{{ cache_label(tree.id) }}{% if tree.html_truncated | default(false) | bool %} <span class="badge off">truncated</span>{% endif %}</h2>
{% if tree.html_truncated | default(false) | bool or tree.truncated | default(false) | bool %}
      <p class="note">Showing {{ (tree.html_objects | default([])) | length }} of {{ tree.object_count | default(0) }} objects; see <span class="mono">{{ infra_stats_path }}.json</span>.</p>
{% endif %}
      <p class="note"><span class="mono">{{ tree.path | e }}</span> · {{ tree.size_human | default('0 B') | e }} · {{ tree.files | default(0) }} files</p>
{% if (tree.upstreams | default([])) | length > 0 %}
      <table>
        <thead>
          <tr><th>Upstream</th><th>Size</th><th>Files</th><th>Tags</th><th>Newest</th></tr>
        </thead>
        <tbody>
{% for up in tree.upstreams %}
          <tr>
            <td class="mono">{{ up.id | e }}</td>
            <td class="mono">{{ up.size_human | default('0 B') | e }}</td>
            <td class="mono">{{ up.files | default(0) }}</td>
            <td class="mono">{{ up.tags | default(0) }}</td>
            <td class="mono">{{ up.newest | default('') | e }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% endif %}
      <table>
        <thead>
          <tr><th>Object</th><th>Size</th><th>mtime</th></tr>
        </thead>
        <tbody>
{% for obj in tree.html_objects | default([]) %}
          <tr>
            <td class="mono break">{% if obj.upstream | default('') %}{{ obj.upstream | e }}/{% endif %}{{ obj.name | e }}</td>
            <td class="mono">{{ obj.size_human | default('') | e }}</td>
            <td class="mono">{{ obj.mtime | default('') | e }}</td>
          </tr>
{% else %}
          <tr><td colspan="3">{% if tree.present | default(false) | bool %}No named objects.{% else %}Directory missing.{% endif %}</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>
    </div>
{% endfor %}
    </div>

    <div data-panel="dns">
    <section>
      <h2>BIND records</h2>
{% if not (infra_stats_bind_scrape_ok | default(true) | bool) %}
{% if infra_stats_bind_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> BIND scrape soft-failed; previous snapshot kept.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> BIND scrape soft-failed; empty result (inventory fallback if no zones).</p>
{% endif %}
{% endif %}
{% if infra_stats_bind_zones | default([]) | length > 0 %}
      <p class="note">Parsed from on-disk zone files under <span class="mono">{{ bind_zones_dir | default('/opt/bind/zones') }}</span>.</p>
{% for zone in infra_stats_bind_zones %}
      <h2 style="font-size:0.95rem;margin-top:0.85rem;">Zone <span class="mono">{{ zone.zone }}</span></h2>
      <table>
        <thead>
          <tr><th>Name</th><th>Type</th><th>Rdata</th></tr>
        </thead>
        <tbody>
{% for rr in zone.records | default([]) %}
          <tr>
            <td class="mono">{{ rr.name }}</td>
            <td class="mono">{{ rr.type }}</td>
            <td class="mono">{{ rr.rdata }}</td>
          </tr>
{% else %}
          <tr><td colspan="3">No matching RRs.</td></tr>
{% endfor %}
        </tbody>
      </table>
{% endfor %}
{% else %}
      <p class="note">No on-disk zones scraped; showing apex/static inventory fallback.</p>
      <table>
        <thead>
          <tr><th>Name</th><th>Type</th><th>Rdata</th></tr>
        </thead>
        <tbody>
{% for rr in infra_stats_bind_inventory_fallback | default([]) %}
          <tr>
            <td class="mono">{{ rr.name }}</td>
            <td class="mono">{{ rr.type }}</td>
            <td class="mono">{{ rr.rdata }}</td>
          </tr>
{% else %}
          <tr><td colspan="3">No inventory apex records.</td></tr>
{% endfor %}
        </tbody>
      </table>
{% endif %}
    </section>
    </div>

    <div data-panel="time">
    <section>
      <h2>NTP</h2>
{% if not (setup_ntp | default(false) | bool) %}
      <p class="note"><span class="badge off">disabled</span> <span class="mono">setup_ntp</span> is false; no compose NTP scrape.</p>
{% elif not (infra_stats_ntp_scrape_ok | default(true) | bool) %}
{% if infra_stats_ntp_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> NTP scrape soft-failed; previous snapshot kept.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> NTP scrape soft-failed; empty result.</p>
{% endif %}
{% else %}
      <p class="note">Compose NTP (<span class="mono">{{ ntp_container_name | default('ntp') }}</span>) via <span class="mono">chronyc</span> in-container. Listen <span class="mono">{{ ntp_listen_ip | default('') }}:123</span>.</p>
{% endif %}
{% set ntp_row = (infra_stats_ntp | default([]))[0] | default({}) %}
{% if ntp_row %}
      <table>
        <thead>
          <tr><th>Field</th><th>Value</th></tr>
        </thead>
        <tbody>
{% set ntp_track = ntp_row.tracking | default({}) %}
          <tr><td>container</td><td class="mono">{{ ntp_row.container | default('?') | e }}</td></tr>
          <tr><td>hostname</td><td class="mono">{{ ntp_row.hostname | default('?') | e }}</td></tr>
          <tr><td>listen_ip</td><td class="mono">{{ ntp_row.listen_ip | default('?') | e }}</td></tr>
          <tr><td>running</td><td>{% if ntp_row.running | default(false) | bool %}<span class="badge on">yes</span>{% else %}<span class="badge off">no</span>{% endif %}</td></tr>
          <tr><td>stratum</td><td class="mono">{{ ntp_track.stratum | default('?') }}</td></tr>
          <tr><td>reference</td><td class="mono">{{ ntp_track.reference | default('?') | e }}{% if ntp_track.reference_name | default('') %} ({{ ntp_track.reference_name | e }}){% endif %}</td></tr>
          <tr><td>system_time_offset</td><td class="mono">{{ ntp_track.system_time_offset | default('?') }}</td></tr>
          <tr><td>last_offset</td><td class="mono">{{ ntp_track.last_offset | default('?') }}</td></tr>
          <tr><td>rms_offset</td><td class="mono">{{ ntp_track.rms_offset | default('?') }}</td></tr>
          <tr><td>frequency_ppm</td><td class="mono">{{ ntp_track.frequency_ppm | default('?') }}</td></tr>
          <tr><td>residual_freq_ppm</td><td class="mono">{{ ntp_track.residual_freq_ppm | default('?') }}</td></tr>
          <tr><td>leap</td><td class="mono">{{ ntp_track.leap | default('?') | e }}</td></tr>
          <tr><td>upstreams_configured</td><td class="mono">{{ (ntp_row.upstreams_configured | default([])) | join(', ') | e }}</td></tr>
        </tbody>
      </table>
{% if (ntp_row.sources | default([])) | length > 0 %}
      <h2 style="font-size:0.95rem;margin-top:0.85rem;">Sources</h2>
      <table>
        <thead>
          <tr><th>Mode</th><th>State</th><th>Name</th><th>Stratum</th><th>Reach</th><th>Last sample</th></tr>
        </thead>
        <tbody>
{% for src in ntp_row.sources %}
          <tr>
            <td class="mono">{{ src.mode | default('?') | e }}</td>
            <td class="mono">{{ src.state | default('?') | e }}</td>
            <td class="mono">{{ src.name | default('?') | e }}</td>
            <td class="mono">{{ src.stratum | default('?') }}</td>
            <td class="mono">{{ src.reach | default('?') | e }}</td>
            <td class="mono">{{ src.last_sample_offset | default('?') | e }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% endif %}
{% elif setup_ntp | default(false) | bool %}
      <p class="note">No NTP scrape rows.</p>
{% endif %}
    </section>
    </div>

    <div data-panel="tls">
    <section>
      <h2>Certificates (known infra leaves + CA chain)</h2>
      <p class="note">On-disk paths for enabled TLS stacks only. Missing means the file is not on disk yet. Published via <span class="mono">{{ generated_by }}</span>.{% if not (infra_stats_known_scrape_ok | default(true) | bool) %}{% if infra_stats_known_scrape_stale | default(false) | bool %} <span class="badge off">stale</span> known-certs scrape soft-failed; previous snapshot kept.{% else %} <span class="badge off">scrape failed</span> known-certs scrape soft-failed; empty result.{% endif %}{% endif %}</p>
      <table>
        <thead>
          <tr><th>Path</th><th>Present</th><th>Subject / issuer / dates / serial</th></tr>
        </thead>
        <tbody>
{% for cert in infra_stats_certs | default([]) %}
          <tr>
            <td class="mono">{{ cert.path | e }}</td>
            <td>
{% if cert.present | default(false) | bool %}
              <span class="badge on">yes</span>
{% else %}
              <span class="badge off">missing</span>
{% endif %}
            </td>
            <td class="mono">
{% if cert.error is defined %}
              error: {{ cert.error | e }}
{% elif cert.present | default(false) | bool %}
              subject={{ cert.subject | default('?') | e }}<br>
              issuer={{ cert.issuer | default('?') | e }}<br>
              notBefore={{ cert.notbefore | default('?') | e }}<br>
              notAfter={{ cert.notafter | default('?') | e }}<br>
              serial={{ cert.serial | default('?') | e }}
{% if cert.sans is defined and (cert.sans | length > 0) %}
              <br>SAN={{ cert.sans | join(', ') | e }}
{% endif %}
{% else %}
              —
{% endif %}
            </td>
          </tr>
{% else %}
          <tr><td colspan="3">No certificate scrape results.</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Certificates issued by step-ca</h2>
{% if not (infra_stats_issued_scrape_ok | default(true) | bool) %}
{% if infra_stats_issued_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> issued scrape soft-failed; previous snapshot kept.</p>
{% elif not (infra_stats_issued_annotate_ok | default(true) | bool) %}
      <p class="note"><span class="badge off">annotate failed</span> issued scrape ok but on_disk annotation not refreshed.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> issued scrape soft-failed; empty result.</p>
{% endif %}
{% endif %}
      <p class="note">Full badger DER scan of <span class="mono">{{ stepca_data_dir | default('/opt/stepca') }}/db</span>. Overlap with known on-disk leaves is expected (<span class="badge on">on disk</span>). May be incomplete after DB compaction.</p>
      <table>
        <thead>
          <tr><th>Subject</th><th>Serial</th><th>Presence</th><th>Issuer / dates / SAN</th></tr>
        </thead>
        <tbody>
{% for cert in infra_stats_issued_certs | default([]) %}
          <tr>
            <td class="mono">{{ cert.subject | default('?') | e }}</td>
            <td class="mono">{{ cert.serial | default('?') | e }}</td>
            <td>
{% if cert.on_disk | default(false) | bool %}
              <span class="badge on">on disk</span>
{% else %}
              <span class="badge off">db only</span>
{% endif %}
            </td>
            <td class="mono">
              issuer={{ cert.issuer | default('?') | e }}<br>
              notBefore={{ cert.notbefore | default('?') | e }}<br>
              notAfter={{ cert.notafter | default('?') | e }}
{% if cert.sans is defined and (cert.sans | length > 0) %}
              <br>SAN={{ cert.sans | join(', ') | e }}
{% endif %}
            </td>
          </tr>
{% else %}
          <tr><td colspan="4">No issued certificates found in step-ca DB (or scrape soft-failed with no prior snapshot).</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>
    </div>

  </main>
  <script>
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-tabs="main"] [data-tab]'));
      var panels = Array.prototype.slice.call(document.querySelectorAll("[data-panel]"));
      var ids = tabs.map(function (t) { return t.getAttribute("data-tab"); });
      var subs = {};
      function bindSub(parentId) {
        var root = document.querySelector('[data-panel="' + parentId + '"]');
        if (!root) return null;
        var stabs = Array.prototype.slice.call(root.querySelectorAll("[data-subtab]"));
        var spans = Array.prototype.slice.call(root.querySelectorAll("[data-subpanel]"));
        var sids = stabs.map(function (t) { return t.getAttribute("data-subtab"); });
        function showSub(id, skipHash) {
          if (sids.indexOf(id) === -1) id = sids[0] || "";
          stabs.forEach(function (t) {
            t.setAttribute("aria-selected", t.getAttribute("data-subtab") === id ? "true" : "false");
          });
          spans.forEach(function (p) {
            p.classList.toggle("is-on", p.getAttribute("data-subpanel") === id);
          });
          try { localStorage.setItem("infra-stats-sub-" + parentId, id); } catch (e) {}
          if (!skipHash && id) {
            try { history.replaceState(null, "", "#" + parentId + "/" + id); } catch (e) {}
          }
          return id;
        }
        stabs.forEach(function (t) {
          t.addEventListener("click", function () { showSub(t.getAttribute("data-subtab")); });
        });
        return { show: showSub, ids: sids };
      }
      ["mirrors", "cache"].forEach(function (id) { subs[id] = bindSub(id); });
      function currentSub(id, preferred) {
        var group = subs[id];
        if (!group) return "";
        if (preferred && group.ids.indexOf(preferred) !== -1) return preferred;
        var stored = "";
        try { stored = localStorage.getItem("infra-stats-sub-" + id) || ""; } catch (e) {}
        if (stored && group.ids.indexOf(stored) !== -1) return stored;
        return group.ids[0] || "";
      }
      function show(id, sub) {
        if (ids.indexOf(id) === -1) id = "trust";
        tabs.forEach(function (t) {
          t.setAttribute("aria-selected", t.getAttribute("data-tab") === id ? "true" : "false");
        });
        panels.forEach(function (p) {
          p.classList.toggle("is-on", p.getAttribute("data-panel") === id);
        });
        try { localStorage.setItem("infra-stats-tab", id); } catch (e) {}
        var group = subs[id];
        if (group) {
          var picked = currentSub(id, sub);
          group.show(picked, true);
          try { history.replaceState(null, "", "#" + id + (picked ? "/" + picked : "")); } catch (e) {}
        } else {
          try { history.replaceState(null, "", "#" + id); } catch (e) {}
        }
      }
      tabs.forEach(function (t) {
        t.addEventListener("click", function () { show(t.getAttribute("data-tab")); });
      });
      var fromHash = (location.hash || "").replace(/^#/, "");
      var parts = fromHash.split("/");
      var fromStore = "";
      try { fromStore = localStorage.getItem("infra-stats-tab") || ""; } catch (e) {}
      show(parts[0] || fromStore || "trust", parts[1] || "");
    })();
  </script>
</body>
</html>
