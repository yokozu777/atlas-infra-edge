<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Infra stats — {{ dns_domain_suffix | default('lab') }}</title>
  <style>
    :root {
      --bg: #0f1419;
      --panel: #1a2332;
      --text: #e7ecf3;
      --muted: #9aa8bc;
      --accent: #5b9fd4;
      --line: #2a3648;
      --ok: #3d9a6a;
      --off: #8a6a3d;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      background: radial-gradient(1200px 600px at 10% -10%, #1c2a3d, var(--bg));
      color: var(--text);
      line-height: 1.45;
    }
    header {
      padding: 1.5rem 1.25rem 0.75rem;
      border-bottom: 1px solid var(--line);
      text-align: center;
    }
    header h1 {
      margin: 0 0 0.35rem;
      font-size: 1.45rem;
      font-weight: 650;
      letter-spacing: 0.01em;
    }
    header p { margin: 0; color: var(--muted); font-size: 0.95rem; }
    header a { color: var(--accent); }
    main {
      padding: 1rem 1.25rem 2.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    section {
      margin-top: 1.25rem;
      background: color-mix(in srgb, var(--panel) 92%, black);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.9rem 1rem 1rem;
    }
    section h2 {
      margin: 0 0 0.65rem;
      font-size: 1.05rem;
      font-weight: 600;
    }
    .note { color: var(--muted); font-size: 0.85rem; margin: 0 0 0.75rem; }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    th, td {
      text-align: left;
      vertical-align: top;
      padding: 0.4rem 0.45rem;
      border-bottom: 1px solid var(--line);
    }
    th { color: var(--muted); font-weight: 550; }
    code, .mono {
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.84em;
    }
    .break { word-break: break-all; }
    .badge {
      display: inline-block;
      padding: 0.1rem 0.45rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .on { background: color-mix(in srgb, var(--ok) 35%, transparent); color: #b8f0d0; }
    .off { background: color-mix(in srgb, var(--off) 35%, transparent); color: #f0d9b0; }
    ul.compact, ul.tight { margin: 0.2rem 0; padding-left: 1.1rem; }
    ul.compact li, ul.tight li { margin: 0.15rem 0; }
  </style>
</head>
<body>
  <header>
    <h1>Infra stats · {{ dns_domain_suffix | default('lab') }}</h1>
    <p>
      Generated by <span class="mono">{{ generated_by }}</span>
      · <a href="{{ infra_stats_path }}.json">{{ infra_stats_path }}.json</a>
      · host <span class="mono">{{ infra_stats_hostname }}</span>
    </p>
  </header>
  <main>

    <section>
      <h2>Trust / CA</h2>
      <p class="note">
        First fetch uses <span class="mono">curl -k</span> (stats TLS is signed by this CA).
        Debian/Ubuntu: <span class="mono">update-ca-certificates</span>.
        RHEL/OL: <span class="mono">update-ca-trust extract</span>.
      </p>
{% set ca = infra_stats_ca | default({}) %}
      <ul class="tight">
        <li><a href="{{ ca.pem_path | default('/ca/roots.pem') }}">Root CA PEM</a>
          <span class="mono">{{ ca.pem_path | default('/ca/roots.pem') }}</span>
{% if not (ca.pem_ok | default(false)) %}
          <span class="badge off">pem missing</span>
{% endif %}
        </li>
        <li><a href="{{ ca.debian_sh | default('/ca/install-root-ca-debian.sh') }}">Install on Debian/Ubuntu</a>
          <span class="mono">{{ ca.debian_sh | default('/ca/install-root-ca-debian.sh') }}</span></li>
        <li><a href="{{ ca.rhel_sh | default('/ca/install-root-ca-rhel.sh') }}">Install on RHEL/OL</a>
          <span class="mono">{{ ca.rhel_sh | default('/ca/install-root-ca-rhel.sh') }}</span></li>
{% if ca.step_url | default('') %}
        <li>step-ca: <a href="{{ ca.step_url }}" class="mono">{{ ca.step_url }}</a></li>
{% endif %}
{% for u in ca.upstream_urls | default([]) %}
{% if u and u != (ca.step_url | default('')) %}
        <li>also: <a href="{{ u }}" class="mono">{{ u }}</a></li>
{% endif %}
{% endfor %}
      </ul>
    </section>

    <section>
      <h2>Nginx locations</h2>
      <p class="note">Known stacks from inventory / templates (not a live <span class="mono">nginx -T</span> dump).</p>
      <table>
        <thead>
          <tr><th>Stack</th><th>State</th><th>Server names</th><th>Locations</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_nginx_locations | default([]) %}
          <tr>
            <td class="mono">{{ row.stack }}</td>
            <td>
{% if row.enabled | default(false) | bool %}
              <span class="badge on">enabled</span>
{% else %}
              <span class="badge off">disabled</span>
{% endif %}
            </td>
            <td>
              <ul class="compact">
{% for name in row.server_names | default([]) %}
{% if name %}
                <li class="mono">{{ name }}</li>
{% endif %}
{% endfor %}
              </ul>
            </td>
            <td>
              <ul class="compact">
{% for loc in row.locations | default([]) %}
                <li><span class="mono">{{ loc.pattern }}</span> — {{ loc.note }}</li>
{% endfor %}
              </ul>
            </td>
          </tr>
{% else %}
          <tr><td colspan="4">No nginx summary available.</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <h2>APT / YUM repos</h2>
      <p class="note">From <span class="mono">pkg_repo_upstreams</span> + <span class="mono">enable_repo_*</span>.</p>
{% if infra_stats_pkg_repos | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>Warm</th><th>Slug</th><th>Proxy host</th><th>Upstream</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_pkg_repos %}
          <tr>
            <td>
{% if row.enabled | default(false) | bool %}
              <span class="badge on">on</span>
{% else %}
              <span class="badge off">off</span>
{% endif %}
            </td>
            <td class="mono">{{ row.slug }}</td>
            <td class="mono">{{ row.proxy_hostname }}</td>
            <td class="mono">{{ row.upstream_url }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">Pkg-repo mirror disabled or no upstreams.</p>
{% endif %}
    </section>

    <section>
      <h2>Helm repos</h2>
      <p class="note">From <span class="mono">helm_repo_upstreams</span> → <span class="mono">*.helm.{{ dns_domain_suffix | default('') }}</span>.</p>
{% if infra_stats_helm_repos | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>Name</th><th>Proxy host</th><th>Upstream</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_helm_repos %}
          <tr>
            <td class="mono">{{ row.name }}</td>
            <td class="mono">{{ row.proxy_hostname }}</td>
            <td class="mono">{{ row.upstream_url }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">Helm-repo mirror disabled or no upstreams.</p>
{% endif %}
    </section>

    <section>
      <h2>Docker / registry mirrors</h2>
      <p class="note">From <span class="mono">containerd_registry_mirrors</span> / registry nginx server names.</p>
{% set hub = infra_stats_docker_hub | default({}) %}
{% if hub.remaining is number %}
      <p>
{% if hub.ok | default(false) %}
        <span class="badge on">ok</span>
{% elif hub.stale | default(false) %}
        <span class="badge off">stale</span>
{% else %}
        <span class="badge off">scrape failed</span>
{% endif %}
        Hub pulls left: <span class="mono">{{ hub.remaining }} / {{ hub.limit | default('?') }}</span>
{% if hub.window_sec | default(0) %}
        (window {{ (hub.window_sec / 3600) | round(0, 'floor') | int }}h{% if hub.reset | default('') %}, reset {{ hub.reset }}{% endif %})
{% elif hub.reset | default('') %}
        (reset {{ hub.reset }})
{% endif %}
        · source <span class="mono">{{ hub.source | default('anonymous') }}</span>
        — anonymous Hub quota for this host WAN IP (pull-through shares it).
      </p>
{% elif hub.error | default('') %}
      <p class="note"><span class="badge off">scrape failed</span> Docker Hub quota: {{ hub.error | e }}</p>
{% else %}
      <p class="note">Docker Hub quota not scraped yet.</p>
{% endif %}
{% if infra_stats_docker_repos | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>dir_name</th><th>Proxy host</th><th>Upstream</th><th>Mode</th></tr>
        </thead>
        <tbody>
{% for row in infra_stats_docker_repos %}
          <tr>
            <td class="mono">{{ row.dir_name }}</td>
            <td class="mono">{{ row.proxy_hostname }}</td>
            <td class="mono">{{ row.server }}</td>
            <td>{% if row.direct | default(false) | bool %}direct{% else %}proxy{% endif %}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% else %}
      <p class="note">Registry nginx disabled or no mirrors.</p>
{% endif %}
    </section>

    <section>
      <h2>Infra cache</h2>
{% if not (infra_stats_cache_scrape_ok | default(true) | bool) %}
{% if infra_stats_cache_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> Cache scrape soft-failed; previous snapshot kept.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> Cache scrape soft-failed; empty result.</p>
{% endif %}
{% else %}
      <p class="note">On-disk trees. Nginx pkg/helm rows are <span class="mono">KEY:</span> URIs (not an apt/helm catalog). Newest first; HTML shows up to <span class="mono">{{ infra_stats_cache_html_limit | default(200) }}</span> objects per tree — full list in <span class="mono">{{ infra_stats_path }}.json</span>.</p>
{% endif %}
{% if infra_stats_cache | default([]) | length > 0 %}
      <table>
        <thead>
          <tr><th>Tree</th><th>Path</th><th>Size</th><th>Files</th><th>Newest</th><th>State</th></tr>
        </thead>
        <tbody>
{% for tree in infra_stats_cache %}
          <tr>
            <td class="mono">{{ tree.id | e }}</td>
            <td class="mono break">{{ tree.path | e }}</td>
            <td class="mono">{{ tree.size_human | default('0 B') | e }}</td>
            <td class="mono">{{ tree.files | default(0) }}</td>
            <td class="mono">{{ tree.newest | default('') | e }}</td>
            <td>
{% if tree.present | default(false) | bool %}
{% if (tree.files | default(0)) | int > 0 %}
              <span class="badge on">present</span>
{% else %}
              <span class="badge off">empty</span>
{% endif %}
{% else %}
              <span class="badge off">missing</span>
{% endif %}
            </td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% for tree in infra_stats_cache %}
      <h2 style="font-size:0.95rem;margin-top:0.85rem;">{{ tree.id | e }}{% if tree.html_truncated | default(false) | bool %} <span class="badge off">truncated</span>{% endif %}</h2>
{% if tree.html_truncated | default(false) | bool or tree.truncated | default(false) | bool %}
      <p class="note">Showing {{ (tree.html_objects | default([])) | length }} of {{ tree.object_count | default(0) }} objects; see <span class="mono">{{ infra_stats_path }}.json</span>.</p>
{% endif %}
{% if (tree.upstreams | default([])) | length > 0 %}
      <table>
        <thead>
          <tr><th>Upstream</th><th>Size</th><th>Files</th><th>Tags</th><th>Newest</th></tr>
        </thead>
        <tbody>
{% for up in tree.upstreams %}
          <tr>
            <td class="mono">{{ up.id | e }}</td>
            <td class="mono">{{ up.size_human | default('0 B') | e }}</td>
            <td class="mono">{{ up.files | default(0) }}</td>
            <td class="mono">{{ up.tags | default(0) }}</td>
            <td class="mono">{{ up.newest | default('') | e }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% endif %}
      <table>
        <thead>
          <tr><th>Object</th><th>Size</th><th>mtime</th></tr>
        </thead>
        <tbody>
{% for obj in tree.html_objects | default([]) %}
          <tr>
            <td class="mono break">{% if obj.upstream | default('') %}{{ obj.upstream | e }}/{% endif %}{{ obj.name | e }}</td>
            <td class="mono">{{ obj.size_human | default('') | e }}</td>
            <td class="mono">{{ obj.mtime | default('') | e }}</td>
          </tr>
{% else %}
          <tr><td colspan="3">{% if tree.present | default(false) | bool %}No named objects.{% else %}Directory missing.{% endif %}</td></tr>
{% endfor %}
        </tbody>
      </table>
{% endfor %}
{% else %}
      <p class="note">No cache trees enabled (pkg/helm/registry/custom-www gates off).</p>
{% endif %}
    </section>

    <section>
      <h2>BIND records</h2>
{% if not (infra_stats_bind_scrape_ok | default(true) | bool) %}
{% if infra_stats_bind_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> BIND scrape soft-failed; previous snapshot kept.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> BIND scrape soft-failed; empty result (inventory fallback if no zones).</p>
{% endif %}
{% endif %}
{% if infra_stats_bind_zones | default([]) | length > 0 %}
      <p class="note">Parsed from on-disk zone files under <span class="mono">{{ bind_zones_dir | default('/opt/bind/zones') }}</span>.</p>
{% for zone in infra_stats_bind_zones %}
      <h2 style="font-size:0.95rem;margin-top:0.85rem;">Zone <span class="mono">{{ zone.zone }}</span></h2>
      <table>
        <thead>
          <tr><th>Name</th><th>Type</th><th>Rdata</th></tr>
        </thead>
        <tbody>
{% for rr in zone.records | default([]) %}
          <tr>
            <td class="mono">{{ rr.name }}</td>
            <td class="mono">{{ rr.type }}</td>
            <td class="mono">{{ rr.rdata }}</td>
          </tr>
{% else %}
          <tr><td colspan="3">No matching RRs.</td></tr>
{% endfor %}
        </tbody>
      </table>
{% endfor %}
{% else %}
      <p class="note">No on-disk zones scraped; showing apex/static inventory fallback.</p>
      <table>
        <thead>
          <tr><th>Name</th><th>Type</th><th>Rdata</th></tr>
        </thead>
        <tbody>
{% for rr in infra_stats_bind_inventory_fallback | default([]) %}
          <tr>
            <td class="mono">{{ rr.name }}</td>
            <td class="mono">{{ rr.type }}</td>
            <td class="mono">{{ rr.rdata }}</td>
          </tr>
{% else %}
          <tr><td colspan="3">No inventory apex records.</td></tr>
{% endfor %}
        </tbody>
      </table>
{% endif %}
    </section>

    <section>
      <h2>NTP</h2>
{% if not (setup_ntp | default(false) | bool) %}
      <p class="note"><span class="badge off">disabled</span> <span class="mono">setup_ntp</span> is false; no compose NTP scrape.</p>
{% elif not (infra_stats_ntp_scrape_ok | default(true) | bool) %}
{% if infra_stats_ntp_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> NTP scrape soft-failed; previous snapshot kept.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> NTP scrape soft-failed; empty result.</p>
{% endif %}
{% else %}
      <p class="note">Compose NTP (<span class="mono">{{ ntp_container_name | default('ntp') }}</span>) via <span class="mono">chronyc</span> in-container. Listen <span class="mono">{{ ntp_listen_ip | default('') }}:123</span>.</p>
{% endif %}
{% set ntp_row = (infra_stats_ntp | default([]))[0] | default({}) %}
{% if ntp_row %}
      <table>
        <thead>
          <tr><th>Field</th><th>Value</th></tr>
        </thead>
        <tbody>
{% set ntp_track = ntp_row.tracking | default({}) %}
          <tr><td>container</td><td class="mono">{{ ntp_row.container | default('?') | e }}</td></tr>
          <tr><td>hostname</td><td class="mono">{{ ntp_row.hostname | default('?') | e }}</td></tr>
          <tr><td>listen_ip</td><td class="mono">{{ ntp_row.listen_ip | default('?') | e }}</td></tr>
          <tr><td>running</td><td>{% if ntp_row.running | default(false) | bool %}<span class="badge on">yes</span>{% else %}<span class="badge off">no</span>{% endif %}</td></tr>
          <tr><td>stratum</td><td class="mono">{{ ntp_track.stratum | default('?') }}</td></tr>
          <tr><td>reference</td><td class="mono">{{ ntp_track.reference | default('?') | e }}{% if ntp_track.reference_name | default('') %} ({{ ntp_track.reference_name | e }}){% endif %}</td></tr>
          <tr><td>system_time_offset</td><td class="mono">{{ ntp_track.system_time_offset | default('?') }}</td></tr>
          <tr><td>last_offset</td><td class="mono">{{ ntp_track.last_offset | default('?') }}</td></tr>
          <tr><td>rms_offset</td><td class="mono">{{ ntp_track.rms_offset | default('?') }}</td></tr>
          <tr><td>frequency_ppm</td><td class="mono">{{ ntp_track.frequency_ppm | default('?') }}</td></tr>
          <tr><td>residual_freq_ppm</td><td class="mono">{{ ntp_track.residual_freq_ppm | default('?') }}</td></tr>
          <tr><td>leap</td><td class="mono">{{ ntp_track.leap | default('?') | e }}</td></tr>
          <tr><td>upstreams_configured</td><td class="mono">{{ (ntp_row.upstreams_configured | default([])) | join(', ') | e }}</td></tr>
        </tbody>
      </table>
{% if (ntp_row.sources | default([])) | length > 0 %}
      <h2 style="font-size:0.95rem;margin-top:0.85rem;">Sources</h2>
      <table>
        <thead>
          <tr><th>Mode</th><th>State</th><th>Name</th><th>Stratum</th><th>Reach</th><th>Last sample</th></tr>
        </thead>
        <tbody>
{% for src in ntp_row.sources %}
          <tr>
            <td class="mono">{{ src.mode | default('?') | e }}</td>
            <td class="mono">{{ src.state | default('?') | e }}</td>
            <td class="mono">{{ src.name | default('?') | e }}</td>
            <td class="mono">{{ src.stratum | default('?') }}</td>
            <td class="mono">{{ src.reach | default('?') | e }}</td>
            <td class="mono">{{ src.last_sample_offset | default('?') | e }}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
{% endif %}
{% elif setup_ntp | default(false) | bool %}
      <p class="note">No NTP scrape rows.</p>
{% endif %}
    </section>

    <section>
      <h2>Certificates (known infra leaves + CA chain)</h2>
      <p class="note">On-disk paths for enabled TLS stacks only. Missing means the file is not on disk yet. Published via <span class="mono">{{ generated_by }}</span>.{% if not (infra_stats_known_scrape_ok | default(true) | bool) %}{% if infra_stats_known_scrape_stale | default(false) | bool %} <span class="badge off">stale</span> known-certs scrape soft-failed; previous snapshot kept.{% else %} <span class="badge off">scrape failed</span> known-certs scrape soft-failed; empty result.{% endif %}{% endif %}</p>
      <table>
        <thead>
          <tr><th>Path</th><th>Present</th><th>Subject / issuer / dates / serial</th></tr>
        </thead>
        <tbody>
{% for cert in infra_stats_certs | default([]) %}
          <tr>
            <td class="mono">{{ cert.path | e }}</td>
            <td>
{% if cert.present | default(false) | bool %}
              <span class="badge on">yes</span>
{% else %}
              <span class="badge off">missing</span>
{% endif %}
            </td>
            <td class="mono">
{% if cert.error is defined %}
              error: {{ cert.error | e }}
{% elif cert.present | default(false) | bool %}
              subject={{ cert.subject | default('?') | e }}<br>
              issuer={{ cert.issuer | default('?') | e }}<br>
              notBefore={{ cert.notbefore | default('?') | e }}<br>
              notAfter={{ cert.notafter | default('?') | e }}<br>
              serial={{ cert.serial | default('?') | e }}
{% if cert.sans is defined and (cert.sans | length > 0) %}
              <br>SAN={{ cert.sans | join(', ') | e }}
{% endif %}
{% else %}
              —
{% endif %}
            </td>
          </tr>
{% else %}
          <tr><td colspan="3">No certificate scrape results.</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Certificates issued by step-ca</h2>
{% if not (infra_stats_issued_scrape_ok | default(true) | bool) %}
{% if infra_stats_issued_scrape_stale | default(false) | bool %}
      <p class="note"><span class="badge off">stale</span> issued scrape soft-failed; previous snapshot kept.</p>
{% elif not (infra_stats_issued_annotate_ok | default(true) | bool) %}
      <p class="note"><span class="badge off">annotate failed</span> issued scrape ok but on_disk annotation not refreshed.</p>
{% else %}
      <p class="note"><span class="badge off">scrape failed</span> issued scrape soft-failed; empty result.</p>
{% endif %}
{% endif %}
      <p class="note">Full badger DER scan of <span class="mono">{{ stepca_data_dir | default('/opt/stepca') }}/db</span>. Overlap with known on-disk leaves is expected (<span class="badge on">on disk</span>). May be incomplete after DB compaction.</p>
      <table>
        <thead>
          <tr><th>Subject</th><th>Serial</th><th>Presence</th><th>Issuer / dates / SAN</th></tr>
        </thead>
        <tbody>
{% for cert in infra_stats_issued_certs | default([]) %}
          <tr>
            <td class="mono">{{ cert.subject | default('?') | e }}</td>
            <td class="mono">{{ cert.serial | default('?') | e }}</td>
            <td>
{% if cert.on_disk | default(false) | bool %}
              <span class="badge on">on disk</span>
{% else %}
              <span class="badge off">db only</span>
{% endif %}
            </td>
            <td class="mono">
              issuer={{ cert.issuer | default('?') | e }}<br>
              notBefore={{ cert.notbefore | default('?') | e }}<br>
              notAfter={{ cert.notafter | default('?') | e }}
{% if cert.sans is defined and (cert.sans | length > 0) %}
              <br>SAN={{ cert.sans | join(', ') | e }}
{% endif %}
            </td>
          </tr>
{% else %}
          <tr><td colspan="4">No issued certificates found in step-ca DB (or scrape soft-failed with no prior snapshot).</td></tr>
{% endfor %}
        </tbody>
      </table>
    </section>

  </main>
</body>
</html>
